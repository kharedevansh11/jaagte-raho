PORT=3000
# Neon: DATABASE_URL is the pooled URL (host has -pooler), DIRECT_URL the same without -pooler (used for migrations).
# Locally both point at the Docker Postgres.
DATABASE_URL="postgresql://jaagte:jaagte@localhost:5433/jaagte"
DIRECT_URL="postgresql://jaagte:jaagte@localhost:5433/jaagte"

# Bolna (https://platform.bolna.ai → Developers → API keys)
BOLNA_API_KEY=
BOLNA_CHECKIN_AGENT_ID=
BOLNA_ALERT_AGENT_ID=
# Optional: leave empty to use your Bolna account's default number
BOLNA_FROM_NUMBER=

# Shared secret in the webhook URL you paste into Bolna:
# https://<your-host>/webhooks/bolna?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=
# Owner sign-in with Clerk (https://dashboard.clerk.com → API keys)
CLERK_SECRET_KEY=
# Frontend origins allowed to use a sign-in session (comma-separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Redis for the BullMQ job queue (webhooks, owner alerts)
REDIS_URL=redis://localhost:6379

APP_TIMEZONE=Asia/Kolkata
CALL_INTERVAL_MINUTES=20
# Faster re-call after a sleepy or missed check-in; set both to 1 for the stage demo
RECALL_MINUTES=10
ALERT_COOLDOWN_MINUTES=30
DEMO_CALLS_PER_DAY=50
